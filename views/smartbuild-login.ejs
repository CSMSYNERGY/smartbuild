<!DOCTYPE html>
<html>
<head>
    <title>Finish Setup</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container">
        <div class="row justify-content-center min-vh-100 align-items-center">
            <div class="col-md-6 col-lg-4">
                <h1 class="text-center mb-4">Complete Application Setup</h1>
                <p class="text-center mb-4">
                Please provide your SmartBuild credentials to enable automatic job management. 
                This integration allows the application to create, edit, and retrieve SmartBuild jobs on your behalf.
                </p>
                <div class="card shadow">
                    <div class="card-body p-4">
                        <h3 class="text-center mb-4">Authenticate SmartBuild</h3>
                        <form id="loginForm">
                            <div class="mb-3">
                                <label for="username" class="form-label">Username</label>
                                <input type="text" class="form-control" id="username" required>
                            </div>
                            <div class="mb-4">
                                <label for="password" class="form-label">Password</label>
                                <input type="password" class="form-control" id="password" required>
                            </div>
                            <button type="submit" class="btn btn-primary w-100" id="submitButton">
                                Submit Credentials
                            </button>
                        </form>
                        <div id="error" class="alert alert-danger mt-3" style="display: none;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('loginForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const username = document.getElementById('username').value;
            const password = document.getElementById('password').value;
            const errorDiv = document.getElementById('error');
            const submitButton = document.getElementById('submitButton');
            
            // Clear previous errors
            errorDiv.style.display = 'none';
            
            // Disable button and show loading state
            submitButton.disabled = true;
            submitButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Logging in...';
            
            try {
                const response = await fetch('/auth/authenticate-smartbuild', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        smartbuildUserId: username,
                        smartbuildUserPassword: password,
                        accessToken: '<%= accessToken %>', // Passed from controller
                        locationId: '<%= locationId %>' // Passed from controller
                    })
                });

                const data = await response.json();

                if (response.ok) {
                    window.location.href = data.redirect;
                } else {
                    throw new Error(data.error || 'Authentication failed');
                }
            } catch (error) {
                errorDiv.textContent = error.message || 'An error occurred during login. Please try again.';
                errorDiv.style.display = 'block';
                
                // Reset button state
                submitButton.disabled = false;
                submitButton.textContent = 'Submit Credentials';
            }
        });
    </script>
</body>
</html>